{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fastapi: dev",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "conda activate fastapi && python -m fastapi dev ${workspaceFolder}\\carsharing.py"
